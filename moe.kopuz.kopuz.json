{
  "app-id": "moe.kopuz.kopuz",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "kopuz",
  "separate-locales": false,
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--device=dri",
    "--share=network",
    "--filesystem=xdg-music:ro",
    "--filesystem=xdg-download:rw",
    "--filesystem=xdg-run/discord-ipc-0",
    "--filesystem=xdg-run/app/com.discordapp.Discord:create",
    "--talk-name=org.mpris.MediaPlayer2.kopuz.*",
    "--own-name=org.mpris.MediaPlayer2.kopuz",
    "--talk-name=org.kde.StatusNotifierWatcher"
  ],
  "modules": [
    {
      "name": "kopuz",
      "buildsystem": "simple",
      "cleanup": [
        "/lib/sdk"
      ],
      "build-options": {
        "strip": true,
        "prepend-path": "/app/lib/sdk/rust/bin",
        "env": {
          "RUST_BACKTRACE": "1",
          "CARGO_HOME": "/run/build/kopuz/cargo",
          "CARGO_NET_OFFLINE": "true",
          "RUSTY_V8_ARCHIVE": "/run/build/kopuz/librusty.a.gz",
          "SQLX_OFFLINE": "true",
          "KOPUZ_FLAVOR": "stable"
        }
      },
      "build-commands": [
        "cargo build --frozen --release -p kopuz -p kopuz-kopuzd -p kopuz-ctl",
        "install -Dm755 -t $FLATPAK_DEST/bin target/release/{kopuz,kopuzd,kopuzctl}",
        "install -Dm644 data/$FLATPAK_ID.desktop $FLATPAK_DEST/share/applications/$FLATPAK_ID.desktop",
        "install -Dm644 data/$FLATPAK_ID.metainfo.xml $FLATPAK_DEST/share/metainfo/$FLATPAK_ID.metainfo.xml",
        "install -Dm644 apps/legacy/kopuz/assets/logo-128.png $FLATPAK_DEST/share/icons/hicolor/128x128/apps/$FLATPAK_ID.png",
        "install -Dm644 apps/legacy/kopuz/assets/logo-512.png $FLATPAK_DEST/share/icons/hicolor/512x512/apps/$FLATPAK_ID.png"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/Kopuz-org/kopuz.git",
          "tag": "v1.0.1",
          "commit": "77c30e9478d028b138f93076709a6e1cd06cdf62",
          "x-checker-data": {
            "type": "git",
            "is-main-source": true,
            "tag-pattern": "^v(\\d+\\.\\d+\\.\\d+)$"
          }
        },
        "rust.json",
        "cargo-sources.json",
        "librusty.json"
      ]
    }
  ]
}
